# Tai khoan admin mac dinh, chi duoc tao khi bang users con trong
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# Chỉ dùng khi chạy Docker/Coolify (đặt ở biến môi trường của hệ thống, không đặt trong file này):
#   DB_PATH=/data/tasks.db      đường dẫn database (thư mục phải là volume lưu bền)
#   TRUST_PROXY=1               chạy sau reverse proxy HTTPS (lấy IP thật, cookie Secure)
#   SEED_FILE=/app/backend/seed-data.json   file danh sách Dev / mẫu checklist (tùy chọn)
